# 이 파일은 예시입니다. 실제 값을 채운 .env 또는 실제 배포 환경의 환경변수로 주입하세요.
# .env 파일 자체는 .gitignore에 의해 git에 올라가지 않습니다.

# ── 공통 ─────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# local(H2, 기본값) / dev / prod 중 선택

# ── DB (dev/prod, MySQL) ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hanium_dev
DB_USERNAME=hanium
DB_PASSWORD=changeme
DB_POOL_SIZE=10

# ── Redis (분석 진행률 캐시 용도) ─────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── 외부 엔진 ──────────────────────────
ANALYSIS_ENGINE_BASE_URL=http://localhost:8001
VIDEO_LLM_ENGINE_BASE_URL=http://localhost:8002

# analysis-engine/video-llm-engine 호출 시 보내는 내부 공유 키입니다. 두 엔진 실행 터미널의
# INTERNAL_ENGINE_API_KEY와 반드시 같은 값이어야 합니다(각 엔진의 .env.example 참고).
# dev/prod 프로필에서는 이 값이 비어 있으면 기동 시점에 IllegalStateException으로 즉시
# 실패합니다(InternalEngineApiKeyStartupValidator). local 프로필에서는 강제하지 않습니다.
INTERNAL_ENGINE_API_KEY=

# ── 보안 ──────────────────────────────
# dev/prod 프로필에서는 아래 두 placeholder 값 중 하나라도 그대로 두면 기동 시점에
# IllegalStateException으로 즉시 실패합니다(JwtSecretStartupValidator). 반드시 강력한
# 무작위 값으로 교체하세요. 무작위 값 생성 예: openssl rand -hex 32
SECURITY_JWT_SECRET=change-me-to-a-strong-random-secret-in-production
SECURITY_JWT_EXPIRATION_MINUTES=30

# ── 관리자 권한 ────────────────────────
# 쉼표로 구분된 관리자 이메일 목록입니다. 회원가입/로그인마다 이 목록과 대조해 role을 자동
# 동기화합니다(목록에 있으면 ADMIN으로 승격, 빠지면 USER로 강등). 비어 있으면 관리자가 없습니다.
ADMIN_EMAILS=

# ── OpenAI ────────────────────────────
# OPENAI_ENABLED=false 이면 항상 MOCK 피드백만 생성합니다.
# true로 켜려면 실제 API 키도 함께 넣어야 REAL 모드가 동작합니다.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

# ── 비밀번호 재설정 이메일 ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
MAIL_FROM_ADDRESS=no-reply@example.com
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_CAPACITY=5
PASSWORD_RESET_RATE_LIMIT_REFILL_MINUTES=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_CAPACITY=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_REFILL_MINUTES=10

# ── Video LLM 비용 한도 ────────────────
# NVIDIA hosted Video LLM 실제 호출의 월간 예산 가드입니다. 정확한 무료 한도가 아직 확정되지
# 않아 기본 capacity는 보수적인 500회입니다. 실제 계약/카탈로그 한도에 맞춰 조정하세요.
VIDEO_LLM_MONTHLY_RATE_LIMIT_CAPACITY=500
VIDEO_LLM_MONTHLY_RATE_LIMIT_REFILL_MINUTES=44640

# ── 사용자 조회 API 호출 한도 ─────────────
RESULTS_QUERY_RATE_LIMIT_CAPACITY=120
RESULTS_QUERY_RATE_LIMIT_REFILL_MINUTES=1
VIDEO_ACCESS_TOKEN_RATE_LIMIT_CAPACITY=30
VIDEO_ACCESS_TOKEN_RATE_LIMIT_REFILL_MINUTES=1
JOB_STATUS_POLL_RATE_LIMIT_CAPACITY=90
JOB_STATUS_POLL_RATE_LIMIT_REFILL_MINUTES=1

# ── CORS ──────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 파일 저장 경로 ─────────────────────
STORAGE_ROOT_PATH=../storage
STORAGE_UPLOAD_PATH=../storage/uploads
STORAGE_RESULT_PATH=../storage/results
STORAGE_TEMP_PATH=../storage/temp
STORAGE_LOG_PATH=../storage/logs
