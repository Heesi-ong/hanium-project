# 이 파일은 예시입니다. 복사해서 .env로 저장하거나, 실행 전 셸에서 export하세요.
# docker-compose로 실행할 때는 루트 .env.example/.env의 값이 자동으로 주입되므로
# 이 파일은 video-llm-engine을 단독으로(uvicorn으로 직접) 실행/테스트할 때 참고합니다.

# backend가 POST /api/video-llm/analyze 호출 시 보내는 X-Internal-Api-Key와 반드시 같은
# 값이어야 합니다. 비어 있으면 이 엔진은 모든 /api/** 요청을 401로 거절합니다(fail-closed,
# app/core/security.py의 verify_internal_api_key). 새 환경에서 이 값을 빠뜨리면 엔진 프로세스
# 자체는 정상 기동되고 /health도 200을 반환하므로, 실제 분석 요청을 보내기 전까지는 문제를
# 알아채기 어렵습니다 — backend/analysis-engine과 반드시 같은 값으로 맞추세요.
INTERNAL_ENGINE_API_KEY=

# 실제 Video LLM의 실패 정책입니다: STRICT | DEGRADED | DISABLED.
# STRICT는 실제 호출 실패를 502로 반환하고, DEGRADED만 generationMode=FALLBACK 샘플
# 결과를 허용합니다. DISABLED는 실제 모델을 호출하지 않고 MOCK 결과를 반환합니다.
# 비어 있으면 하위 호환을 위해 VIDEO_LLM_ENABLED 값으로 정책을 유도합니다.
VIDEO_LLM_POLICY=DISABLED

# 이전 배포와의 호환용입니다. VIDEO_LLM_POLICY가 비어 있을 때 true=DEGRADED,
# false=DISABLED로 해석됩니다.
VIDEO_LLM_ENABLED=false

# NVIDIA build.nvidia.com API Catalog에서 발급받는 API 키입니다(nvapi- 접두사).
# 키가 비어 있는데 정책이 STRICT/DEGRADED이면 서비스가 시작되지 않습니다.
NVIDIA_API_KEY=

# NVIDIA Nemotron omni-modal reasoning hosted API 모델 ID입니다.
# 로그인 후 Deploy/API 탭의 실제 코드 예시에서 모델 ID가 달라지면 이 값으로 덮어쓰세요.
NVIDIA_VIDEO_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# NVIDIA API Catalog의 OpenAI-compatible API base URL입니다.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# 180KB를 초과하는 영상 업로드에 사용하는 NVCF Asset API base URL입니다.
NVIDIA_ASSET_API_BASE_URL=https://api.nvcf.nvidia.com/v2/nvcf

# 영상 분석 외부 호출 timeout입니다. 긴 영상 분석을 감안해 기본값을 120초로 둡니다.
NVIDIA_VIDEO_LLM_TIMEOUT_SECONDS=120

# NVIDIA 계정 전체가 공유하는 순간 rate limit(공식 SLA는 아니지만 약 40 RPM으로
# 보고됨, docs/service-plan/video-llm-model-options.md 참고)에 여러 분석 작업이
# 동시에 몰리지 않도록, 실제 모델 호출의 동시 실행 수 자체를 앱 레벨에서 제한합니다.
VIDEO_LLM_REAL_MODEL_MAX_CONCURRENCY=3

# 위 동시 실행 한도가 이미 다 찼을 때, 순번을 기다릴 최대 시간(초)입니다. 이 시간
# 안에 순번을 못 받으면 예외를 던져 기존 mock 폴백(FALLBACK) 경로로 넘어갑니다.
VIDEO_LLM_REAL_MODEL_SEMAPHORE_TIMEOUT_SECONDS=30

# 라이브 테스트에서 성공이 확인된 안전 구간(120초)보다 여유를 둔 값입니다. 이보다 긴
# 영상은 ffmpeg로 실제로 잘라 이 길이 단위로 NVIDIA를 여러 번 호출한 뒤 결과를 하나로
# 합칩니다(각 호출의 시간은 최종적으로 원본 영상 기준 절대 시간으로 오프셋됩니다).
VIDEO_LLM_CHUNK_DURATION_SECONDS=100

# 위 구간 분할(ffmpeg) 1회에 허용하는 최대 시간(초)입니다. -c copy(재인코딩 없음)라
# 보통 매우 빠르게 끝납니다.
VIDEO_LLM_SEGMENT_SPLIT_TIMEOUT_SECONDS=30

# backend가 업로드 시점에 VIDEO_MAX_DURATION_MINUTES(기본 30분)로 이미 영상 길이를
# 제한하지만, durationSec 값 자체가 잘못 전달되는 경우(단위 착오 등)에 대비해 이
# 엔진에서도 방어적으로 한 번 더 상한을 둡니다. 초과하면 실제 NVIDIA 호출/ffmpeg
# 분할을 시도하지 않고 즉시 mock FALLBACK으로 처리합니다.
VIDEO_LLM_MAX_DURATION_SECONDS=7200

# 다운로드·로컬 파일·NVIDIA Asset 업로드 전에 강제하는 단일 영상 최대 크기(MB)입니다.
# 1 이상의 정수만 허용하며 잘못된 값은 프로세스 시작을 거부합니다.
VIDEO_LLM_MAX_VIDEO_SIZE_MB=500

# backend가 항상 안전한 경로만 보내지만, 방어적으로 videoPath가 이 디렉터리(마운트된
# 공유 스토리지 루트) 밖을 가리키면 거부합니다. 경로 이탈 시 임의 파일이 NVIDIA로
# 업로드되는 것을 막기 위함입니다.
VIDEO_LLM_ALLOWED_VIDEO_BASE_DIR=/storage

# videoDownloadUrl이 가리킬 수 있는 MinIO host:port 허용 목록입니다. 비어 있거나
# host:port 형식이 아니면 프로세스가 시작되지 않습니다.
VIDEO_LLM_ALLOWED_DOWNLOAD_HOSTS=minio:9000

# 이 이미지가 어떤 의존성 세트로 빌드됐는지(GET /api/internal/readiness의
# installedBackend에도 노출됩니다): mock | external-api | local-model.
# Dockerfile의 VIDEO_LLM_BACKEND build arg와 짝을 이루며, 여기서 값만 바꿔도 이미지
# 내용은 바뀌지 않습니다. 정책이 STRICT/DEGRADED일 때는 external-api만 허용됩니다.
VIDEO_LLM_BACKEND=mock

# 분석 진행 로그를 저장할 디렉토리입니다. 지정하지 않으면 ../storage/logs를 사용합니다.
# docker-compose에서는 컨테이너 안의 /storage/logs로 고정되어 있습니다.
LOG_DIR=../storage/logs
