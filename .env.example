# 학생 프로젝트의 로컬/테스트 docker-compose.yml 환경변수 예시입니다.
# 복사해서 .env로 저장한 뒤 로컬 값으로 채우세요. .env는 git에 올라가지 않습니다.
# production/TLS/원격 백업/상시 관제 설정은 현재 실행 범위에 포함하지 않습니다.

SPRING_PROFILES_ACTIVE=dev

DB_NAME=hanium_dev
DB_HOST=127.0.0.1
DB_USERNAME=hanium
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
DB_PORT=3306

REDIS_PORT=6379
# 로컬 Redis 테스트 비밀번호입니다.
REDIS_PASSWORD=changeme
# Redis 장애 시 API 요청이 기본 60초 가까이 대기하지 않도록 연결·명령 timeout을 제한합니다.
# 너무 작으면 로컬 PC의 일시적인 지연도 장애로 오인할 수 있습니다.
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000

# 업로드 영상 본문 상한과 multipart 요청 전체 상한입니다. 요청 상한은 boundary·헤더
# 여유를 위해 파일 상한보다 최소 1MiB 크게 유지해야 backend가 기동됩니다.
VIDEO_MAX_FILE_SIZE=500MB
VIDEO_MAX_REQUEST_SIZE=501MB

# MinIO(S3 호환 오브젝트 스토리지) 로컬 테스트 계정입니다.
# MINIO_ROOT_USER는 3자 이상, MINIO_ROOT_PASSWORD는 8자 이상이어야 합니다.
MINIO_ROOT_USER=hanium-minio-admin
MINIO_ROOT_PASSWORD=changeme12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=hanium-storage
# 브라우저가 영상을 재생할 때 사용하는 MinIO 공개 접근 URL입니다. 로컬 docker compose
# 개발에서는 보통 위 MINIO_PORT와 같은 포트의 localhost면 충분합니다. 같은 내부망의
# 다른 기기에서도 영상 재생이 되게 하려면(docker-compose.yml에서 MinIO 9000 포트를
# 0.0.0.0으로 열어둔 이유), 이 값을 이 PC의 LAN IP로 바꿔야 합니다. 안 바꾸면 다른
# 기기는 자기 자신의 9000번 포트로 접속을 시도해 재생이 깨집니다.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# 로컬에만 있던 기존 uploads/results 파일을 MinIO로 1회성 백필할 때만 true로 설정합니다.
# true로 켠 채 기동하면 백필 후 애플리케이션이 자동 종료되므로 1회성 테스트에서만 사용하세요.
STORAGE_BACKFILL_ENABLED=false

# 로컬에서 analysis-engine/video-llm-engine 호스트 포트가 이미 사용 중이면 이 값을 바꿔 충돌을 피할 수 있습니다.
ANALYSIS_ENGINE_PORT=8001
VIDEO_LLM_ENGINE_PORT=8002

# analysis-engine이 시작할 때 미리 생성해 재사용하는 모델별 인스턴스 수입니다.
# 각 값은 1 이상의 정수여야 하며 컨테이너 CPU/메모리 한도에 맞춰 조정하세요.
ANALYSIS_ENGINE_WHISPER_POOL_SIZE=2
ANALYSIS_ENGINE_POSE_POOL_SIZE=2
ANALYSIS_ENGINE_FACE_POOL_SIZE=2
# analysis-engine이 MinIO에서 임시 디스크로 받을 단일 영상 최대 크기(MB)입니다.
ANALYSIS_ENGINE_MAX_VIDEO_SIZE_MB=500
# 손상된 오디오 등으로 Whisper STT가 끝나지 않는 경우를 대비한 상한(초)입니다.
ANALYSIS_ENGINE_WHISPER_TRANSCRIBE_TIMEOUT_SECONDS=600
# videoDownloadUrl(backend가 만드는 MinIO presigned URL)이 가리킬 수 있는 host:port
# 허용 목록입니다(SSRF 방지). docker-compose 내부 MinIO 주소(minio:9000)가 기본값입니다.
ANALYSIS_ENGINE_ALLOWED_DOWNLOAD_HOSTS=minio:9000
# videoPath로 읽을 수 있는 로컬 파일의 허용 루트 디렉터리입니다.
ANALYSIS_ENGINE_ALLOWED_VIDEO_BASE_DIR=/storage

# /actuator/health 응답의 상세 정보 노출 정책입니다. 기본값은 인증된 요청에만 상세 노출입니다.
ACTUATOR_HEALTH_SHOW_DETAILS=when-authorized

# actuator(health, prometheus 등)를 메인 API 포트(8080)와 분리해서 노출하는 관리 포트입니다.
# docker-compose에서 호스트에 노출하지 않으며, 같은 docker 네트워크 내부(nginx, 모니터링 도구)에서만 접근합니다.
MANAGEMENT_SERVER_PORT=8081

# backend(api) 서비스의 실행 역할입니다. 기본 docker-compose 구성은 api/worker 분리 실행이라
# 둘 다 false(=/run이 접수만 하고, analysis-worker 서비스가 큐를 폴링해 실행)를 씁니다.
# 단일 프로세스(monolith)로 되돌리려면 둘 다 true로 바꾸세요. analysis-worker 서비스 자체는
# 역할이 고정돼 있어 이 값의 영향을 받지 않습니다.
BACKEND_ANALYSIS_WORKER_ENABLED=false
BACKEND_ANALYSIS_DISPATCH_LOCAL_ON_RUN=false

# JWT 서명 비밀값과 access token 만료 시간(분)입니다.
# 로컬 테스트에서도 예시 문구를 그대로 쓰지 말고 별도 값을 사용하세요.
# 만료 시간은 XSS로 토큰이 탈취됐을 때 노출 기간을 줄이기 위해 30분으로 단축했습니다.
SECURITY_JWT_SECRET=change-me-for-local-test-only
SECURITY_JWT_EXPIRATION_MINUTES=30
# 로그아웃된 access token의 DB 폐기 원장에서 만료 행을 정리하는 주기입니다.
JWT_REVOCATION_CLEANUP_CRON=0 15 * * * *
# HttpOnly access_token 쿠키의 Secure 속성입니다. localhost HTTP 테스트에서는 false를 사용합니다.
SECURITY_JWT_COOKIE_SECURE=false

# Swagger UI와 OpenAPI JSON 공개 여부입니다. 로컬 API 확인 편의를 위해 true를 사용합니다.
SECURITY_API_DOCS_PUBLIC_ENABLED=true

# 쉼표로 구분된 관리자 이메일 목록입니다. 회원가입/로그인마다 이 목록과 대조해 role을 자동
# 동기화합니다(목록에 있으면 ADMIN으로 승격, 빠지면 USER로 강등). 비어 있으면 관리자가 없습니다.
ADMIN_EMAILS=

# backend가 analysis-engine/video-llm-engine의 /api/** 분석 API를 호출할 때 쓰는 내부 공유 키입니다.
# 세 서비스(backend, analysis-engine, video-llm-engine) 모두 같은 값을 가져야 합니다. 이 값은
# 필수값입니다. 비어 있으면 docker compose up 자체가 즉시 실패합니다(docker-compose.yml의
# ${INTERNAL_ENGINE_API_KEY:?...} 필수 변수 검사, dev/prod에서는 backend도
# InternalEngineApiKeyStartupValidator가 기동 시점에 한 번 더 검사). 값이 비어 있지 않아도
# 세 서비스 간에 값이 서로 다르면 분석 요청이 401로 거절됩니다. GET /api/health/engines는
# 더 이상 존재하지 않으며(제거됨), 현재는 GET /api/status 응답의 analysisEngine/
# videoLlmEngine 항목이 UNAVAILABLE로 나오는지로 간접 확인하거나, backend와 각 엔진의
# 로그에서 401 응답을 직접 확인해야 합니다.
# 무작위 값 생성 예: openssl rand -hex 32
INTERNAL_ENGINE_API_KEY=

# 분석 엔진 호출 실패가 반복될 때 backend 스레드가 장시간 대기하지 않도록 회로 차단기를 엽니다.
ANALYSIS_ENGINE_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
ANALYSIS_ENGINE_CIRCUIT_BREAKER_MINIMUM_NUMBER_OF_CALLS=5
ANALYSIS_ENGINE_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
# 로컬 부하 실측에서 정상 분석도 89~252초가 걸렸습니다. Resilience4j 기본 60초를 쓰면
# 성공 응답 5건만으로 slow-call rate 100%가 되어 회로가 열리므로, HTTP read timeout(10분)
# 아래인 5분부터 실제 지연 장애로 집계합니다.
ANALYSIS_ENGINE_CIRCUIT_BREAKER_SLOW_CALL_DURATION_THRESHOLD=5m
ANALYSIS_ENGINE_CIRCUIT_BREAKER_SLOW_CALL_RATE_THRESHOLD=100
ANALYSIS_ENGINE_CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE=30s
ANALYSIS_ENGINE_CIRCUIT_BREAKER_HALF_OPEN_PERMITTED_CALLS=3
ANALYSIS_ENGINE_CIRCUIT_BREAKER_AUTO_HALF_OPEN_ENABLED=true
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_MINIMUM_NUMBER_OF_CALLS=5
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
# Video LLM은 긴 영상을 여러 100초 세그먼트로 나눠 순차 호출합니다. 단일 NVIDIA 호출
# timeout(120초)이 아니라 전체 backend HTTP read timeout(10분) 직전부터 slow로 봅니다.
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_SLOW_CALL_DURATION_THRESHOLD=9m
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_SLOW_CALL_RATE_THRESHOLD=100
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE=30s
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_HALF_OPEN_PERMITTED_CALLS=3
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_AUTO_HALF_OPEN_ENABLED=true

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MONTHLY_RATE_LIMIT_CAPACITY=1000
OPENAI_MONTHLY_RATE_LIMIT_REFILL_MINUTES=44640

# AI 코치 채팅이 현재 발표 외에 같은 사용자의 다른 완료된 발표(재분석 제외) 점수 이력을
# 최근 순으로 몇 개까지 함께 참고할지입니다. 점수만 담아 토큰 비용을 억제합니다.
COACH_HISTORY_SUMMARY_SIZE=5

# AI 코치가 어떤 LLM을 호출할지: openai(기본, 선택적 외부 API 테스트) | nvidia(build.nvidia.com의
# 무료/오픈 모델로 대체 - 아래 NVIDIA_API_KEY를 이미 채워둔 video-llm-engine과 같은 키를
# 재사용합니다. docker-compose.yml이 COACH_LLM_NVIDIA_API_KEY/BASE_URL로 자동 연결합니다).
# OpenAI 키가 없을 때 NVIDIA provider 호출 경로를 선택적으로 테스트할 수 있습니다.
COACH_LLM_PROVIDER=openai
COACH_LLM_NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it

# 분석 피드백(강점/개선점/연습 계획) 생성도 같은 방식으로 대체할 수 있습니다. nvidia는
# strict json_schema를 지원하지 않아 json_object 모드로 대체하므로, 실제 OpenAI보다
# 필드 누락 가능성이 있습니다.
FEEDBACK_LLM_PROVIDER=openai
FEEDBACK_LLM_NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
FEEDBACK_LLM_NVIDIA_TIMEOUT_MS=90000

# 비밀번호 재설정 이메일 테스트 설정입니다. SMTP_HOST가 비어 있으면
# 외부 메일을 발송하지 않고 재설정 링크를 로컬 개발 로그로 확인합니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000
MAIL_FROM_ADDRESS=no-reply@example.com
# false로 명시하면 SMTP 설정과 무관하게 재설정 요청/확인 API를 항상 거절합니다.
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_CAPACITY=5
PASSWORD_RESET_RATE_LIMIT_REFILL_MINUTES=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_CAPACITY=10
PASSWORD_RESET_CONFIRM_RATE_LIMIT_REFILL_MINUTES=10
# outbox DB에는 reset link가 AES-GCM 암호문으로만 저장됩니다. 로컬 테스트에서도 32자 이상의
# 별도 비밀값을 사용하고 pending/dead-letter 작업이 있는 도중에 키를 바꾸지 마세요.
PASSWORD_RESET_OUTBOX_ENCRYPTION_KEY=
PASSWORD_RESET_OUTBOX_POLL_INTERVAL_MS=5000
PASSWORD_RESET_OUTBOX_MAX_ATTEMPTS=5
PASSWORD_RESET_OUTBOX_BASE_BACKOFF_SECONDS=30
PASSWORD_RESET_OUTBOX_MAX_BACKOFF_SECONDS=300
PASSWORD_RESET_OUTBOX_CLAIM_LEASE_SECONDS=60
# 만료된 지 오래된(사용/무효화 여부 무관) 재설정 토큰 행을 주기적으로 삭제하는 스케줄러입니다.
PASSWORD_RESET_CLEANUP_CRON=0 30 3 * * *
PASSWORD_RESET_CLEANUP_RETENTION_DAYS=7
# 로그인된 상태에서 현재 비밀번호를 확인하고 새 비밀번호로 바꾸는 API의 rate limit입니다.
PASSWORD_CHANGE_RATE_LIMIT_CAPACITY=10
PASSWORD_CHANGE_RATE_LIMIT_REFILL_MINUTES=10

# Video LLM 제품 실패 정책입니다.
# DISABLED: 실제 모델을 호출하지 않고 명시적 MOCK 결과를 반환합니다.
# DEGRADED: 실제 호출 실패 시 FALLBACK 샘플 결과를 반환합니다.
# STRICT: 실제 호출 실패 시 502를 반환해 backend 분석 작업도 실패시킵니다.
# 비어 있으면 하위 호환을 위해 VIDEO_LLM_ENABLED=true는 DEGRADED, false는 DISABLED로
# 해석합니다. 테스트에서는 아래 정책 값을 명시하세요.
VIDEO_LLM_POLICY=DISABLED

# 이전 설정과의 호환용 스위치입니다. VIDEO_LLM_POLICY가 비어 있을 때만 정책을 결정합니다.
# 로컬 테스트에서는 위 정책과 의미가 일치하도록 false(DISABLED) 또는 true(STRICT/DEGRADED)로
# 함께 설정하세요.
VIDEO_LLM_ENABLED=false

# NVIDIA build.nvidia.com API Catalog에서 발급받은 nvapi- 키입니다.
# 정책이 STRICT/DEGRADED일 때 비어 있으면 Video LLM 서비스가 시작되지 않습니다.
# 정상 기동 뒤 외부 API 호출 실패는 STRICT에서는 502, DEGRADED에서만 FALLBACK입니다.
NVIDIA_API_KEY=

# NVIDIA Nemotron omni-modal reasoning hosted API 설정입니다.
NVIDIA_VIDEO_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ASSET_API_BASE_URL=https://api.nvcf.nvidia.com/v2/nvcf
NVIDIA_VIDEO_LLM_TIMEOUT_SECONDS=120
# 다운로드·분할·대기·모든 세그먼트 호출을 합친 전체 deadline입니다. backend의
# HTTP read timeout(기본 10분)보다 짧게 유지합니다.
VIDEO_LLM_TOTAL_TIMEOUT_SECONDS=540
# MinIO/로컬에서 읽어 NVIDIA로 전송할 단일 영상의 최대 크기입니다. backend 업로드 상한과
# 동일한 500MB가 기본이며, 다운로드 헤더와 실제 스트림 바이트 모두에서 검사합니다.
VIDEO_LLM_MAX_VIDEO_SIZE_MB=500
# videoPath가 이 디렉터리(마운트된 공유 스토리지 루트) 밖을 가리키면 거부합니다.
# backend가 항상 안전한 경로만 보내 지금은 비활성 위험이지만, 방어적으로 둡니다.
VIDEO_LLM_ALLOWED_VIDEO_BASE_DIR=/storage
# videoDownloadUrl(backend가 만드는 MinIO presigned URL)이 가리킬 수 있는 host:port
# 허용 목록입니다(SSRF 방지). docker-compose 내부 MinIO 주소(minio:9000)가 기본값입니다.
VIDEO_LLM_ALLOWED_DOWNLOAD_HOSTS=minio:9000
# NVIDIA 계정 전체가 공유하는 순간 rate limit(공식 SLA는 아니지만 약 40 RPM으로
# 보고됨)에 여러 분석 작업이 동시에 몰리지 않도록, 실제 모델 호출의 동시 실행 수
# 자체를 video-llm-engine에서 제한합니다.
VIDEO_LLM_REAL_MODEL_MAX_CONCURRENCY=3
VIDEO_LLM_REAL_MODEL_SEMAPHORE_TIMEOUT_SECONDS=30
# 라이브 테스트에서 성공이 확인된 안전 구간(120초)보다 긴 영상은 ffmpeg로 실제로 잘라
# 이 길이 단위로 NVIDIA를 여러 번 호출한 뒤 결과를 하나로 합칩니다. backend도 같은
# 값으로 월간 예산을 ceil(duration/chunk)만큼 예약하므로 서비스별로 다르게 설정하지 마세요.
VIDEO_LLM_CHUNK_DURATION_SECONDS=100
VIDEO_LLM_SEGMENT_SPLIT_TIMEOUT_SECONDS=30
# backend가 업로드 시점에 VIDEO_MAX_DURATION_MINUTES(기본 30분)로 이미 제한하지만,
# durationSec 값 자체가 잘못 전달되는 경우(단위 착오 등)에 대비해 video-llm-engine
# 쪽에서도 방어적으로 한 번 더 상한을 둡니다. 정상적인 업로드 정책보다 넉넉합니다.
VIDEO_LLM_MAX_DURATION_SECONDS=7200

# NVIDIA hosted Video LLM 실제 세그먼트 호출의 월간 예산 가드입니다. NVIDIA 무료 API의
# 정확한 호출 한도가 아직 확정되지 않아 보수적인 500회를 기본값으로 둡니다.
VIDEO_LLM_MONTHLY_RATE_LIMIT_CAPACITY=500
VIDEO_LLM_MONTHLY_RATE_LIMIT_REFILL_MINUTES=44640
VIDEO_LLM_DAILY_RATE_LIMIT_CAPACITY=10
VIDEO_LLM_DAILY_RATE_LIMIT_REFILL_MINUTES=1440

# video-llm-engine 이미지를 어떤 의존성 세트로 빌드할지: mock(기본) | external-api |
# local-model. mock/external-api는 가벼운 requirements-base.txt만 설치하고, local-model만
# torch/transformers 등 무거운 실제 모델 스택(requirements-real-model.txt)을 설치합니다.
# Docker build arg이자 런타임 이미지 식별값입니다. VIDEO_LLM_ENABLED=true이면 반드시
# external-api여야 하며, 값을 바꾸면 --build로 이미지를 다시 빌드해야 합니다.
VIDEO_LLM_BACKEND=mock

# 같은 내부망의 다른 기기(예: http://<이 PC의 IP>:5173)에서 접속하려면, 그 기기가
# 브라우저에서 보내는 Origin도 여기 콤마로 추가해야 합니다. 안 하면 로그인/회원가입이
# CORS로 막힙니다(403). PC의 IP가 DHCP로 바뀌면 이 값도 다시 맞춰야 합니다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 비워두면 프론트가 상대경로(/api)로 호출하고, frontend 컨테이너의 nginx가
# BACKEND_API_UPSTREAM(backend:8080)으로 프록시합니다. 같은 내부망의 다른 기기에서
# 접속했을 때도 API가 그 기기 자신의 localhost가 아니라 실제 서버로 향합니다.
# 절대 URL(예: http://localhost:8080)을 넣으면 그 값이 프론트 빌드에 그대로 박혀서
# 다른 기기에서는 접속이 막힙니다.
VITE_API_BASE_URL=

# SIGTERM 수신 시 HTTP 요청과 분석 백그라운드 작업을 graceful하게 마무리할 유예 시간입니다.
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30
ANALYSIS_EXECUTOR_AWAIT_TERMINATION_SECONDS=25
# 워커 한 인스턴스의 동시 분석 수와 로컬 대기열입니다. 기본값은 기존 동작과 동일합니다.
# 부하 테스트 결과와 CPU/메모리 용량에 맞춰 조정하며 core <= max를 유지하세요.
ANALYSIS_EXECUTOR_CORE_POOL_SIZE=2
ANALYSIS_EXECUTOR_MAX_POOL_SIZE=4
ANALYSIS_EXECUTOR_QUEUE_CAPACITY=20

UPLOAD_RATE_LIMIT_CAPACITY=5
UPLOAD_RATE_LIMIT_REFILL_MINUTES=1
ANALYSIS_RATE_LIMIT_CAPACITY=5
ANALYSIS_RATE_LIMIT_REFILL_MINUTES=1
LOGIN_RATE_LIMIT_CAPACITY=5
LOGIN_RATE_LIMIT_REFILL_MINUTES=10
LOGIN_IP_RATE_LIMIT_CAPACITY=20
LOGIN_IP_RATE_LIMIT_REFILL_MINUTES=10
SIGNUP_RATE_LIMIT_CAPACITY=5
SIGNUP_RATE_LIMIT_REFILL_MINUTES=10
RESULTS_QUERY_RATE_LIMIT_CAPACITY=120
RESULTS_QUERY_RATE_LIMIT_REFILL_MINUTES=1
VIDEO_ACCESS_TOKEN_RATE_LIMIT_CAPACITY=30
VIDEO_ACCESS_TOKEN_RATE_LIMIT_REFILL_MINUTES=1
# 상태(1.5초)와 진행률(1초) 동시 polling 약 100회/분을 허용하는 로컬 기본값입니다.
JOB_STATUS_POLL_RATE_LIMIT_CAPACITY=120
JOB_STATUS_POLL_RATE_LIMIT_REFILL_MINUTES=1

# localhost 직접 접속에서는 false를 유지합니다.
# false이면 로그인/회원가입/비밀번호 재설정 rate limit는 request remote address를 사용합니다.
SECURITY_CLIENT_IP_TRUST_FORWARDED_HEADERS=false

# 실패한 분석 작업의 최대 재시도 허용 횟수입니다.
ANALYSIS_RETRY_MAX_COUNT=3

# 진행 중 상태로 오래 멈춘 분석 작업을 자동 실패 처리하는 워치도그 주기와 임계 시간입니다.
ANALYSIS_STUCK_JOB_CRON=0 */10 * * * *
ANALYSIS_STUCK_JOB_MAX_RUNNING_MINUTES=30

# Docker Compose가 모든 서비스에 마운트할 호스트 스토리지 루트입니다.
# 별도 COMPOSE_PROJECT_NAME/빈 DB로 E2E를 실행할 때는 반드시 전용 임시 경로로 바꾸세요.
# 새 DB의 고아 정리 작업이 기존 ./storage 데이터를 삭제하는 것을 방지합니다.
STORAGE_HOST_PATH=./storage

# storage/temp 잔여물과 DB에 없는 uploads/results 고아 디렉토리 정리 주기입니다.
STORAGE_CLEANUP_CRON=0 0 * * * *
STORAGE_CLEANUP_TEMP_MAX_AGE_HOURS=6
STORAGE_CLEANUP_ORPHAN_MAX_AGE_HOURS=24

# 완료된 분석 작업의 원본 업로드 영상 보존 기간과 정리 주기입니다. 결과 JSON은 삭제하지 않습니다.
STORAGE_RETENTION_CRON=0 0 3 * * *
STORAGE_RETENTION_ORIGINAL_VIDEO_DAYS=30

# MinIO 삭제 outbox 재시도, 처리 lease, 완료 이력 보존 정책입니다. claim lease는 worker
# 분산 락 TTL보다 길어야 하며, 완료 행은 기본 30일 보존 후 하루 한 번 최대 500건씩 정리합니다.
STORAGE_DELETION_WORKER_CRON=0 */2 * * * *
STORAGE_DELETION_MAX_ATTEMPTS=8
STORAGE_DELETION_BASE_BACKOFF_MINUTES=2
STORAGE_DELETION_MAX_BACKOFF_MINUTES=240
STORAGE_DELETION_CLAIM_LEASE_MINUTES=5
STORAGE_DELETION_COMPLETED_RETENTION_DAYS=30
STORAGE_DELETION_COMPLETED_CLEANUP_CRON=0 30 3 * * *

# 업로드를 계속 허용할 최소 디스크 여유 공간(MB)입니다. 이보다 여유 공간이 적으면 업로드가 거부됩니다.
STORAGE_MIN_FREE_SPACE_MB=2048

# MinIO 저장 정책입니다. 로컬 테스트 기본값은 파일 시스템 fallback을 허용하기 위해 false입니다.
STORAGE_OBJECT_WRITE_REQUIRED=false
STORAGE_OBJECT_READ_PREFERRED=false

# 업로드 가능한 영상의 최대 재생 시간(분)입니다. 기본값은 기존 호환을 위해 ffprobe 확인 실패 시
# 업로드를 허용합니다(fail-open). 엄격한 테스트가 필요하면 required를 true로 둡니다.
VIDEO_MAX_DURATION_MINUTES=30
VIDEO_DURATION_PROBE_REQUIRED=false

# 여러 backend 인스턴스에서 스케줄러가 중복 실행되지 않도록 Redis 분산 락을 유지할 시간입니다.
SCHEDULER_LOCK_STORAGE_CLEANUP_TTL_MINUTES=10
SCHEDULER_LOCK_STUCK_JOB_WATCHDOG_TTL_MINUTES=5
SCHEDULER_LOCK_ORIGINAL_VIDEO_RETENTION_TTL_MINUTES=10
SCHEDULER_LOCK_STORAGE_DELETION_WORKER_TTL_MINUTES=1
SCHEDULER_LOCK_STORAGE_DELETION_RETENTION_TTL_MINUTES=10
SCHEDULER_LOCK_PASSWORD_RESET_EMAIL_WORKER_TTL_SECONDS=4
SCHEDULER_LOCK_JWT_REVOCATION_CLEANUP_TTL_MINUTES=10

# 아래는 현재 실행 범위(로컬 시연)가 아닌 선택적 백업(--profile ops)/모니터링
# (docker-compose.monitoring.yml) 구성용 변수입니다. 코드는 남아 있으므로, 이 구성을
# 직접 켜서 쓸 때만 값을 채우세요. 켜지 않으면 비워둬도 됩니다.

# --profile ops로 backup 서비스를 띄울 때 쓰는 MinIO 백업 버킷 이름입니다.
MINIO_BACKUP_BUCKET_NAME=hanium-backups
# 값을 채우면 백업 파일이 .sql.gz.enc로 암호화됩니다. 비어 있으면 평문 백업입니다.
BACKUP_ENCRYPTION_PASSPHRASE=
# true면 BACKUP_ENCRYPTION_PASSPHRASE가 비어 있을 때 백업 자체를 거부합니다.
BACKUP_ENCRYPTION_REQUIRED=false
BACKUP_ENCRYPTION_PBKDF2_ITER=200000
# true면 원격(MinIO) 반출이 실패할 때 백업 자체를 실패로 처리합니다.
BACKUP_REMOTE_REQUIRED=false
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
BACKUP_FAILURE_RETRY_MINUTES=15

# docker-compose.monitoring.yml(Prometheus/Grafana/Alertmanager)을 띄울 때만 필요합니다.
GRAFANA_ADMIN_PASSWORD=changeme
# Alertmanager가 장애 알림을 보낼 SMTP 정보입니다. 값이 비어 있으면 monitoring compose
# 자체가 기동을 거부합니다(${VAR:?...} 필수 변수).
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USERNAME=
ALERT_EMAIL_TO=
