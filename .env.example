# docker-compose.yml에서 사용하는 환경변수 예시입니다.
# 복사해서 .env로 저장한 뒤 실제 값으로 채우세요. (.env는 git에 올라가지 않습니다)

SPRING_PROFILES_ACTIVE=dev

# nginx/certbot 운영 TLS 구성에서 사용할 실제 도메인입니다.
DOMAIN=example.com

DB_NAME=hanium_dev
DB_HOST=127.0.0.1
DB_USERNAME=hanium
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
DB_PORT=3306

REDIS_PORT=6379
# Redis 인증 비밀번호입니다. 운영 배포 시 반드시 강력한 값으로 변경하세요.
REDIS_PASSWORD=changeme

# 로컬에서 analysis-engine/video-llm-engine 호스트 포트가 이미 사용 중이면 이 값을 바꿔 충돌을 피할 수 있습니다.
ANALYSIS_ENGINE_PORT=8001
VIDEO_LLM_ENGINE_PORT=8002

# /actuator/health 응답의 상세 정보 노출 정책입니다. 기본값은 인증된 요청에만 상세 노출입니다.
ACTUATOR_HEALTH_SHOW_DETAILS=when-authorized

# Grafana 관리자 비밀번호입니다. 운영 배포 시 반드시 강력한 값으로 변경하세요.
GRAFANA_ADMIN_PASSWORD=changeme

# actuator(health, prometheus 등)를 메인 API 포트(8080)와 분리해서 노출하는 관리 포트입니다.
# docker-compose에서 호스트에 노출하지 않으며, 같은 docker 네트워크 내부(nginx, 모니터링 도구)에서만 접근합니다.
MANAGEMENT_SERVER_PORT=8081

# backend(api) 서비스의 실행 역할입니다. 기본 docker-compose 구성은 api/worker 분리 배포라
# 둘 다 false(=/run이 접수만 하고, analysis-worker 서비스가 큐를 폴링해 실행)를 씁니다.
# 단일 프로세스(monolith)로 되돌리려면 둘 다 true로 바꾸세요. analysis-worker 서비스 자체는
# 역할이 고정돼 있어 이 값의 영향을 받지 않습니다.
BACKEND_ANALYSIS_WORKER_ENABLED=false
BACKEND_ANALYSIS_DISPATCH_LOCAL_ON_RUN=false

# JWT 서명 비밀값과 access token 만료 시간(분)입니다.
# 운영 배포 시 SECURITY_JWT_SECRET은 반드시 강력한 무작위 값으로 교체해야 합니다(기본값 사용 금지).
# 만료 시간은 XSS로 토큰이 탈취됐을 때 노출 기간을 줄이기 위해 30분으로 단축했습니다.
SECURITY_JWT_SECRET=change-me-to-a-strong-random-secret-in-production
SECURITY_JWT_EXPIRATION_MINUTES=30

# backend가 analysis-engine/video-llm-engine의 /api/** 분석 API를 호출할 때 쓰는 내부 공유 키입니다.
# 세 서비스(backend, analysis-engine, video-llm-engine) 모두 같은 값을 가져야 합니다. 이 값은
# 필수값입니다. 비어 있으면 docker compose up 자체가 즉시 실패합니다(docker-compose.yml의
# ${INTERNAL_ENGINE_API_KEY:?...} 필수 변수 검사, dev/prod에서는 backend도
# InternalEngineApiKeyStartupValidator가 기동 시점에 한 번 더 검사). 값이 비어 있지 않아도
# 세 서비스 간에 값이 서로 다르면 분석 요청이 401로 거절되는데, 이 경우는
# GET /api/health/engines 응답의 readiness.authenticated=false로 확인할 수 있습니다.
# 무작위 값 생성 예: openssl rand -hex 32
INTERNAL_ENGINE_API_KEY=

# 분석 엔진 호출 실패가 반복될 때 backend 스레드가 장시간 대기하지 않도록 회로 차단기를 엽니다.
ANALYSIS_ENGINE_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
ANALYSIS_ENGINE_CIRCUIT_BREAKER_MINIMUM_NUMBER_OF_CALLS=5
ANALYSIS_ENGINE_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
ANALYSIS_ENGINE_CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE=30s
ANALYSIS_ENGINE_CIRCUIT_BREAKER_HALF_OPEN_PERMITTED_CALLS=3
ANALYSIS_ENGINE_CIRCUIT_BREAKER_AUTO_HALF_OPEN_ENABLED=true
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_SLIDING_WINDOW_SIZE=10
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_MINIMUM_NUMBER_OF_CALLS=5
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=50
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_WAIT_DURATION_IN_OPEN_STATE=30s
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_HALF_OPEN_PERMITTED_CALLS=3
VIDEO_LLM_ENGINE_CIRCUIT_BREAKER_AUTO_HALF_OPEN_ENABLED=true

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MONTHLY_RATE_LIMIT_CAPACITY=1000
OPENAI_MONTHLY_RATE_LIMIT_REFILL_MINUTES=44640

# Video LLM 실제 모델 호출 활성화 여부입니다. 아직 실제 벤더가 연동되지 않아 기본값은 false이며,
# true로 설정해도 현재는 미구현 상태라 mock 응답으로 안전하게 폴백합니다.
VIDEO_LLM_ENABLED=false

# video-llm-engine 이미지를 어떤 의존성 세트로 빌드할지: mock(기본) | external-api |
# local-model. mock/external-api는 가벼운 requirements-base.txt만 설치하고, local-model만
# torch/transformers 등 무거운 실제 모델 스택(requirements-real-model.txt)을 설치합니다.
# docker-compose build 시점에만 쓰이는 값이며(런타임 동작은 VIDEO_LLM_ENABLED가 결정),
# 값을 바꾸면 반드시 --build로 이미지를 다시 빌드해야 반영됩니다.
VIDEO_LLM_BACKEND=mock

CORS_ALLOWED_ORIGINS=http://localhost:5173

# 로컬 개발에서 프론트가 별도 포트의 backend를 직접 호출할 때 쓰는 값입니다.
# 운영 배포(docker-compose.prod.yml)는 nginx의 같은 origin /api 프록시를 쓰도록 빈 문자열로 오버라이드합니다.
VITE_API_BASE_URL=http://localhost:8080

# SIGTERM 수신 시 HTTP 요청과 분석 백그라운드 작업을 graceful하게 마무리할 유예 시간입니다.
SERVER_SHUTDOWN_TIMEOUT_SECONDS=30
ANALYSIS_EXECUTOR_AWAIT_TERMINATION_SECONDS=25

UPLOAD_RATE_LIMIT_CAPACITY=5
UPLOAD_RATE_LIMIT_REFILL_MINUTES=1
ANALYSIS_RATE_LIMIT_CAPACITY=5
ANALYSIS_RATE_LIMIT_REFILL_MINUTES=1
LOGIN_RATE_LIMIT_CAPACITY=5
LOGIN_RATE_LIMIT_REFILL_MINUTES=10
LOGIN_IP_RATE_LIMIT_CAPACITY=20
LOGIN_IP_RATE_LIMIT_REFILL_MINUTES=10
SIGNUP_RATE_LIMIT_CAPACITY=5
SIGNUP_RATE_LIMIT_REFILL_MINUTES=10

# 실패한 분석 작업의 최대 재시도 허용 횟수입니다.
ANALYSIS_RETRY_MAX_COUNT=3

# 진행 중 상태로 오래 멈춘 분석 작업을 자동 실패 처리하는 워치도그 주기와 임계 시간입니다.
ANALYSIS_STUCK_JOB_CRON=0 */10 * * * *
ANALYSIS_STUCK_JOB_MAX_RUNNING_MINUTES=30

# storage/temp 잔여물과 DB에 없는 uploads/results 고아 디렉토리 정리 주기입니다.
STORAGE_CLEANUP_CRON=0 0 * * * *
STORAGE_CLEANUP_TEMP_MAX_AGE_HOURS=6
STORAGE_CLEANUP_ORPHAN_MAX_AGE_HOURS=24

# 완료된 분석 작업의 원본 업로드 영상 보존 기간과 정리 주기입니다. 결과 JSON은 삭제하지 않습니다.
STORAGE_RETENTION_CRON=0 0 3 * * *
STORAGE_RETENTION_ORIGINAL_VIDEO_DAYS=30

# 업로드를 계속 허용할 최소 디스크 여유 공간(MB)입니다. 이보다 여유 공간이 적으면 업로드가 거부됩니다.
STORAGE_MIN_FREE_SPACE_MB=2048

# 업로드 가능한 영상의 최대 재생 시간(분)입니다. ffprobe로 확인하며, 확인 자체가 실패하면
# (ffprobe 없음/타임아웃 등) 안전하게 업로드를 허용합니다(fail-open).
VIDEO_MAX_DURATION_MINUTES=30

# 여러 backend 인스턴스에서 스케줄러가 중복 실행되지 않도록 Redis 분산 락을 유지할 시간입니다.
SCHEDULER_LOCK_STORAGE_CLEANUP_TTL_MINUTES=10
SCHEDULER_LOCK_STUCK_JOB_WATCHDOG_TTL_MINUTES=5
SCHEDULER_LOCK_ORIGINAL_VIDEO_RETENTION_TTL_MINUTES=10

# MySQL mysqldump 백업 저장 위치와 보존 기간입니다.
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=14

# 자동 백업 서비스(docker-compose의 backup 서비스)가 백업을 반복 실행하는 주기(시간)입니다.
BACKUP_INTERVAL_HOURS=24
