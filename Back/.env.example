# Comma-separated frontend origins allowed to call the backend directly.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=gpt_app
DB_PASSWORD=change-this-password
DB_NAME=gpt_conversation_app
# Local backup/restore account. Use a least-privilege backup account in production.
DB_BACKUP_USER=root
DB_BACKUP_PASSWORD=
BACKUP_RETENTION_DAYS=30
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=
DB_POOL_SIZE=8
DB_POOL_TIMEOUT_SECONDS=5

SESSION_COOKIE_NAME=session_token
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_API_KEY=
EXTERNAL_AI_API_KEY=
OLLAMA_TIMEOUT_SECONDS=120
MAX_CHAT_CONTENT_CHARS=8000
CHAT_HISTORY_MESSAGES=20
CHAT_PENDING_TIMEOUT_MINUTES=10
ANALYSIS_WORKERS=1
ANALYSIS_POLL_SECONDS=1
ANALYSIS_SOURCE_RETENTION_HOURS=24
# 0 disables automatic deletion of completed results.
ANALYSIS_RESULT_RETENTION_DAYS=0
ORPHAN_FRAME_MIN_AGE_MINUTES=10
MAINTENANCE_INTERVAL_SECONDS=3600
# Uploads are rejected when free disk space is below this threshold.
MIN_FREE_DISK_MB=2048
OLLAMA_HEALTH_TIMEOUT_SECONDS=2
MAX_UPLOAD_MB=500
USER_STORAGE_QUOTA_MB=2048
USER_MAX_ACTIVE_ANALYSES=2
MAX_VIDEO_DURATION_SECONDS=1800
MAX_VIDEO_WIDTH=3840
MAX_VIDEO_HEIGHT=2160
MAX_VIDEO_FPS=60
MAX_VIDEO_FRAMES=108000
MAX_EXTRACTED_FRAMES=1800
MAX_FRAME_STORAGE_MB=2048
WORKER_HEARTBEAT_STALE_SECONDS=300
MAINTENANCE_STALE_SECONDS=7260
ACCOUNT_DELETION_WAIT_SECONDS=30
ANALYSIS_ALGORITHM_VERSION=2026.06.1
