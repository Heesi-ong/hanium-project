# 이 파일은 예시입니다. 복사해서 .env로 저장하거나, 실행 전 셸에서 export하세요.
# docker-compose로 실행할 때는 루트 .env.example/.env의 값이 자동으로 주입되므로
# 이 파일은 analysis-engine을 단독으로(uvicorn으로 직접) 실행/테스트할 때 참고합니다.

# backend가 POST /api/basic-analysis 호출 시 보내는 X-Internal-Api-Key와 반드시 같은 값이어야
# 합니다. 비어 있으면 이 엔진은 모든 /api/** 요청을 401로 거절합니다(fail-closed,
# app/core/security.py의 verify_internal_api_key). 새 환경에서 이 값을 빠뜨리면 엔진 프로세스
# 자체는 정상 기동되고 /health도 200을 반환하므로, 실제 분석 요청을 보내기 전까지는 문제를
# 알아채기 어렵습니다 — backend/video-llm-engine과 반드시 같은 값으로 맞추세요.
INTERNAL_ENGINE_API_KEY=

# 분석 진행 로그를 저장할 디렉토리입니다. 지정하지 않으면 ../storage/logs를 사용합니다.
# docker-compose에서는 컨테이너 안의 /storage/logs로 고정되어 있습니다.
LOG_DIR=../storage/logs

# 프로세스 시작 시 미리 생성해 재사용할 모델 인스턴스 수입니다. 1 이상의 정수만 허용되며,
# 값이 클수록 동시 추론 수와 메모리 사용량이 함께 증가합니다.
ANALYSIS_ENGINE_WHISPER_POOL_SIZE=2
ANALYSIS_ENGINE_POSE_POOL_SIZE=2
ANALYSIS_ENGINE_FACE_POOL_SIZE=2

# presigned URL 다운로드 시 헤더와 실제 스트림 바이트에 강제하는 단일 영상 최대 크기(MB)입니다.
# 1 이상의 정수만 허용하며 잘못된 값은 프로세스 시작을 거부합니다. 실패·빈 응답·초과 시
# 부분 다운로드 파일은 즉시 삭제됩니다.
ANALYSIS_ENGINE_MAX_VIDEO_SIZE_MB=500
