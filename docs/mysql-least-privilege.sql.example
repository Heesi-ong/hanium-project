-- Replace every REPLACE_* value before execution. Do not commit real passwords.
CREATE USER IF NOT EXISTS 'speakinsight_app'@'localhost' IDENTIFIED BY 'REPLACE_APP_PASSWORD';
CREATE USER IF NOT EXISTS 'speakinsight_migration'@'localhost' IDENTIFIED BY 'REPLACE_MIGRATION_PASSWORD';
CREATE USER IF NOT EXISTS 'speakinsight_backup'@'localhost' IDENTIFIED BY 'REPLACE_BACKUP_PASSWORD';

GRANT SELECT, INSERT, UPDATE, DELETE ON gpt_conversation_app.* TO 'speakinsight_app'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES
  ON gpt_conversation_app.* TO 'speakinsight_migration'@'localhost';
GRANT SELECT, SHOW VIEW, TRIGGER, LOCK TABLES
  ON gpt_conversation_app.* TO 'speakinsight_backup'@'localhost';

FLUSH PRIVILEGES;
